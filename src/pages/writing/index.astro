---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import Board from '../../components/Board.astro';
import { mediumPosts, mediumProfile } from '../../data/medium.js';
import { localPosts } from '../../data/writing.js';

const formattedLocalPosts = localPosts.map((p) => ({
  ...p,
  url: `/writing/${p.id}/`
}));

const allPosts = [...formattedLocalPosts, ...mediumPosts].sort((a, b) => b.date.localeCompare(a.date));

const years = [...new Set(allPosts.map((p) => p.date.slice(0, 4)))];
const count = (y) => allPosts.filter((p) => p.date.startsWith(y)).length;
---
<Base
  title="文章"
  description="朱宜振 Lman Chu 的文章。Medium 舊文維持中文原文，之後的新文章中英對照。"
  current="/writing/"
  path="/writing/"
>
  <section class="kit-intro" aria-labelledby="w-title">
    <p class="tag-line">【 <T zh="文章" en="Writing" /> 】</p>
    <h1 id="w-title" class="card-title"><T zh="文章" en="Writing" /></h1>
    <p class="lead"><T zh="Medium 舊文維持中文原文；之後的新文章中英對照。" en="Earlier posts on Medium stay in Chinese. New posts will be bilingual." /></p>
  </section>

  <section class="section writing-list" aria-labelledby="w-title">
    <nav class="year-index" aria-label="年份">
      {years.map((y) => <a class="term-link" href={`#y${y}`}>{y}<span class="n">({count(y)})</span></a>)}
    </nav>
    <Board posts={allPosts} anchors>
      <span><T zh={`自建與 Medium 上的共 ${allPosts.length} 篇，點標題可閱讀全文。`} en={`${allPosts.length} posts on this site and Medium. Titles open the full text.`} /></span>
      <a class="term-link" href={mediumProfile} rel="me noopener"><T zh="Medium 個人頁" en="Medium profile" /> &gt;&gt;</a>
    </Board>
  </section>
</Base>
