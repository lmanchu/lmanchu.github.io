---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateStr = post.data.date;
const formattedDate = dateStr.replace(/-/g, '/');

// Build localized metadata
const description = post.data.description;
const titleZh = post.data.title;
const titleEn = post.data.title_en;
---
<Base
  title={titleZh}
  description={description}
  current="/writing/"
  path={`/writing/${post.id}/`}
  image={post.data.hero}
  imageWidth={post.data.hero ? 2400 : undefined}
  imageHeight={post.data.hero ? 1260 : undefined}
  imageAlt={post.data.hero_alt}
  ogType="article"
>
  <article class="post-article">
    <div class="bbs-header" aria-hidden="true">
      <div class="bbs-line">
        <span class="lbl"><T zh="作者" en="Author" /></span>
        <span class="val">Lman Chu (<T zh="朱宜振" en="Lman Chu" />)</span>
        <span class="lbl"><T zh="看板" en="Board" /></span>
        <span class="val">Writing</span>
      </div>
      <div class="bbs-line">
        <span class="lbl"><T zh="標題" en="Title" /></span>
        <span class="val" lang={post.data.lang === 'en' ? 'en' : 'zh-Hant'}><T zh={titleZh} en={titleEn} /></span>
      </div>
      <div class="bbs-line">
        <span class="lbl"><T zh="時間" en="Time" /></span>
        <span class="val">{formattedDate}</span>
      </div>
    </div>

    {post.data.hero && (
      <figure class="post-hero">
        <img class={post.data.hero_en ? 'zh' : undefined} src={post.data.hero} alt={post.data.hero_alt ?? ''} width="1200" height="630" />
        {post.data.hero_en && <img class="en" lang="en" src={post.data.hero_en} alt={post.data.hero_alt_en ?? ''} width="1200" height="630" />}
      </figure>
    )}

    <div class="post-content">
      <Content />
    </div>

    <div class="post-footer">
      <hr class="bbs-hr" />
      <div class="post-nav-back">
        <a class="term-link" href="/writing/">&lt;&lt; <T zh="返回文章列表" en="Back to articles" /></a>
      </div>
    </div>
  </article>
</Base>

<style is:global>
  /* Scoped styling for BBS-style article layout */
  .post-article {
    margin-top: 2rem;
    margin-bottom: 4rem;
  }
  
  .bbs-header {
    background: #111215;
    border: 1px dashed var(--rule, #333);
    padding: 0.75rem 1rem;
    margin-bottom: 2rem;
    font-family: monospace, var(--font-mono, "VT323");
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ansi-bright-blue, #5c6370);
  }
  
  .bbs-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 0.25rem;
  }
  
  .bbs-line:last-child {
    margin-bottom: 0;
  }
  
  .bbs-header .lbl {
    background: #282c34;
    color: #abb2bf;
    padding: 0.1rem 0.5rem;
    margin-right: 0.75rem;
    border-radius: 2px;
    font-weight: bold;
    min-width: 3.5rem;
    text-align: center;
  }
  
  .bbs-header .val {
    color: var(--ansi-yellow, #e5c07b);
    margin-right: 2rem;
    font-weight: 500;
  }
  
  .post-content {
    font-family: var(--font-sans, "Noto Sans TC"), sans-serif;
    font-size: 1.125rem;
    line-height: 1.9;
    max-width: 38em;
    margin: 0 auto;
    color: var(--foreground, #e0e6ed);
    text-align: justify;
    letter-spacing: 0.01em;
  }

  /* Specific style overrides for data-lang toggle */
  body[data-lang="en"] .post-content {
    font-size: 1.05rem;
    line-height: 1.8;
    letter-spacing: normal;
  }
  
  .post-content p {
    margin-top: 0;
    margin-bottom: 1.5rem;
  }

  /* 文章 hero：社群卡比例（1200×630），中英各一張；同時當 og:image */
  .post-hero {
    max-width: 960px;
    margin: 0 auto 2.5rem;
  }

  .post-hero img {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule, #333);
  }

  /* 文章內的表格、卡片與圖解。綠＝能下載的，紅＝付代價的（ANSI 亮綠／亮紅） */
  .post-content {
    --dl: #55FF55;
    --nodl: #FF5555;
  }

  .post-content h3 {
    font-size: 1.1rem;
    line-height: 1.45;
    margin: 0 0 1rem;
    text-align: left;
  }

  .post-content .tbl,
  .post-content .sort,
  .post-content .callout,
  .post-content .canvas,
  .post-content .example,
  .post-content .bmap,
  .post-content .cards,
  .post-content .stress {
    margin: 0 0 1.75rem;
    text-align: left;
    line-height: 1.6;
  }

  .post-content .tbl { overflow-x: auto; border-top: 2px solid var(--soft); }
  .post-content table { width: 100%; min-width: 30em; border-collapse: collapse; font-size: 0.95rem; }
  .post-content th, .post-content td { padding: 0.6rem 0.9rem 0.6rem 0; border-bottom: 1px solid var(--rule); vertical-align: top; text-align: left; }
  .post-content th { font-size: 0.85rem; font-weight: 500; color: var(--faint); }
  .post-content td.bleed { color: var(--nodl); font-weight: 700; }

  .post-content .sort { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .post-content .col { border: 1px solid var(--rule); min-width: 0; }
  .post-content .col-h { margin: 0; padding: 0.4rem 0.9rem; font-weight: 700; color: #000; }
  .post-content .dl .col-h { background: var(--dl); }
  .post-content .nodl .col-h { background: var(--nodl); }
  .post-content .col ul { list-style: none; margin: 0; padding: 0.25rem 0.9rem 0.5rem; }
  .post-content .col li { padding: 0.6rem 0; border-bottom: 1px solid var(--rule); }
  .post-content .col li:last-child { border-bottom: 0; }
  .post-content .col li b, .post-content .col li small { display: block; }
  .post-content .col li small { font-size: 0.9rem; color: var(--soft); }

  .post-content .callout { padding: 1rem 1.2rem; background: #111215; border-left: 3px solid var(--nodl); }
  .post-content .callout.calm { border-left-color: var(--dl); }
  .post-content .callout p { margin: 0; }

  .post-content .canvas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 2px solid var(--soft); }
  .post-content .cell { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; padding: 0.8rem 0.9rem; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .post-content .cell:nth-child(3n) { border-right: 0; }
  .post-content .cell:nth-child(n+7) { border-bottom: 0; }
  .post-content .cell p { margin: 0; }
  .post-content .cell-k { font-size: 0.8rem; color: var(--faint); }
  .post-content .cell-q { font-size: 0.95rem; font-weight: 500; }
  .post-content .cell-f { margin-top: auto !important; padding-top: 0.4rem; font-size: 0.85rem; color: var(--soft); }
  .post-content .cell.chair { background: #1A0F0F; box-shadow: inset 0 0 0 2px var(--nodl); }
  .post-content .cell.chair .cell-k, .post-content .cell.chair .cell-q { color: var(--nodl); }

  .post-content .example { display: grid; grid-template-columns: 8.5em minmax(0, 1fr); border-top: 2px solid var(--soft); font-size: 0.95rem; }
  .post-content .example dt, .post-content .example dd { margin: 0; padding: 0.55rem 0.9rem 0.55rem 0; border-bottom: 1px solid var(--rule); }
  .post-content .example dt { color: var(--faint); }
  .post-content .example .hot { color: var(--nodl); font-weight: 700; }

  .post-content .ax { margin: 0; padding: 0.3rem 0; text-align: center; font-size: 0.85rem; color: var(--faint); }
  .post-content .ax-row { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 0.3rem; font-size: 0.85rem; color: var(--faint); }
  .post-content .quad { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 2px solid var(--soft); }
  .post-content .q { display: flex; flex-direction: column; gap: 0.3rem; min-height: 6.5rem; padding: 0.9rem; }
  .post-content .q p { margin: 0; }
  .post-content .q b { font-family: var(--serif); font-size: 1.8rem; line-height: 1; }
  .post-content .qa { color: var(--dl); border-right: 1px solid var(--rule-2); border-bottom: 1px solid var(--rule-2); }
  .post-content .qb { border-bottom: 1px solid var(--rule-2); }
  .post-content .qc { border-right: 1px solid var(--rule-2); }
  .post-content .qd { color: var(--nodl); background: #1A0F0F; }

  .post-content .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem; }
  .post-content .card { display: flex; flex-direction: column; gap: 0.45rem; min-width: 0; padding: 0.9rem 1rem 1rem; border: 1px solid var(--rule); font-size: 0.95rem; }
  .post-content .card p, .post-content .card h3 { margin: 0; }
  .post-content .card-top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; font-family: var(--term); font-size: 1.1rem; color: var(--faint); font-size-adjust: cap-height 0.733; }
  .post-content .card .tag { color: var(--soft); }
  .post-content .card .tag.hot { color: var(--nodl); }
  .post-content .card .issue { color: var(--soft); }
  .post-content .card .ask { margin-top: auto; padding-top: 0.55rem; border-top: 1px dashed var(--rule-2); font-weight: 700; }

  .post-content .stress { padding: 1rem 1.2rem 1rem 2.4rem; background: #111215; border: 1px solid var(--nodl); }
  .post-content .stress li { margin: 0.3rem 0; font-weight: 500; }

  @media (max-width: 640px) {
    .post-content .sort, .post-content .cards { grid-template-columns: 1fr; }
    .post-content .canvas { grid-template-columns: 1fr; }
    .post-content .cell, .post-content .cell:nth-child(3n) { border-right: 0; }
    .post-content .cell:nth-child(n+7) { border-bottom: 1px solid var(--rule); }
    .post-content .cell:last-child { border-bottom: 0; }
    .post-content .example { grid-template-columns: 1fr; }
    .post-content .example dt { border-bottom: 0; padding-bottom: 0; }
  }

  .bbs-hr {
    border: none;
    border-top: 1px dashed var(--rule, #333);
    margin: 2.5rem 0 1.5rem 0;
  }
  
  .post-nav-back {
    text-align: left;
    font-size: 1rem;
  }
</style>
