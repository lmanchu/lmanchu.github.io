---
import T from './T.astro';

// 文章列表做成 BBS 看板。posts: [{ date: 'YYYY-MM-DD', title, url, lang?, locked? }]，
// 目前都是 Medium 文章（lang 省略＝中文，locked＝需要 Medium 會員）。
// anchors：年份分隔線加上 id（y2023…），給文章頁的年份索引跳轉
const { posts, limit, anchors = false } = Astro.props;
const list = limit ? posts.slice(0, limit) : posts;
const groups = [];
for (const p of list) {
  const year = p.date.slice(0, 4);
  let g = groups.find((x) => x.year === year);
  if (!g) groups.push((g = { year, items: [] }));
  g.items.push(p);
}
const md = (d) => d.slice(5).replace('-', '/');
---
<div class="board">
  <div class="board-head" aria-hidden="true">
    <span class="col-cur"></span>
    <span><T zh="日期" en="Date" /></span>
    <span><T zh="語言" en="Lang" /></span>
    <span><T zh="標題" en="Title" /></span>
  </div>
  {groups.map((g) => (
    <>
      <div class="board-sep" id={anchors ? `y${g.year}` : undefined}>── {g.year} ‧ <T zh="Medium 舊文" en="From Medium" /> ──</div>
      <ul class="board-list">
        {g.items.map((p) => (
          <li>
            <a class="board-row" href={p.url} rel="noopener">
              <span class="cur" aria-hidden="true">&gt;</span>
              <span class="d">{md(p.date)}</span>
              <span class="l">{p.lang === 'en' ? <T zh="英文" en="EN" /> : <T zh="中文" en="ZH" />}</span>
              <span class="t" lang={p.lang === 'en' ? 'en' : 'zh-Hant'}>{p.title}{p.locked && <span class="tag"><T zh="會員" en="Members" /></span>}</span>
            </a>
          </li>
        ))}
      </ul>
    </>
  ))}
  <div class="board-foot"><slot /></div>
</div>
